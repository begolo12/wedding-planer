DATABASE_URL=postgresql://postgres:password@localhost:5432/wedding_planer
# Dipakai `npm run db:migrate` dan `db:generate`. Untuk Neon, ini alamat
# langsung (unpooled), bukan yang lewat PgBouncer, karena migrasi butuh
# koneksi yang tidak masuk mode transaction pooler. Kalau kosong,
# drizzle.config.ts memakai DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://postgres:password@localhost:5432/wedding_planer
BETTER_AUTH_SECRET=ganti-dengan-nilai-acak-panjang
BETTER_AUTH_URL=http://localhost:3000

# Daftar origin yang boleh mengirim permintaan auth. Diisi kalau aplikasi
# dijalankan di port atau domain lain, misalnya saat uji e2e di port 3110.
# Dipisahkan koma.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Login Google. Kosongkan kalau fitur Google tidak dipakai.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
